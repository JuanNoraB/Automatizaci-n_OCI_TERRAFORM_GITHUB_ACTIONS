# se llenan las variables declaradas en variables.tf
# Los nombres de recursos y las etiquetas DNS se generan solos a partir de project_name + environment.

# ==================== Proyecto y Ambiente ====================
project_name = "INSAGEN"
environment  = "prod"

# ==================== Credenciales OCI ====================
tenancy_ocid     = "xxx"
user_ocid        = "xxx"
fingerprint      = "xxx"
private_key_path = "~/.oci/xxx"
region           = "xxx"

# ==================== Compartment y Red ====================
compartment_ocid = "xxx"
vcn_cidr         = "10.0.0.0/16"
subnet_cidr      = "10.0.2.0/24"

# ==================== Imagen y SSH ====================
image_ocid     = "xxx"
ssh_public_key = "xxx"